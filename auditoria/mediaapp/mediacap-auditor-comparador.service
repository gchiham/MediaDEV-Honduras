# mediaAPP: compara lo desplegado en mediaCAP contra GitHub (solo lectura de ambos lados).
# Escribe solo en /var/lib/mediacap-auditor (clones, reportes, estado del informe). Sin sudo.
# /etc/mediacap-auditor.env es root:root 600: systemd lo lee como root y pasa las variables al
# proceso; el usuario auditor no puede leer el archivo.
[Unit]
Description=Auditor mediaCAP: comparador de despliegue vs GitHub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=auditor
Group=auditor
EnvironmentFile=/etc/mediacap-auditor.env
ExecStart=/opt/mediacap-auditor/auditoria/mediaapp/correr_comparador.sh
Nice=10
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=300M
TimeoutStartSec=300
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/mediacap-auditor
